{
  "name": "chasing-totality",
  "version": "1.0.0",
  "private": true,
  "description": "Totality duration isolines and map for total solar eclipses, starting with 2 August 2027",
  "keywords": [
    "eclipse",
    "totality",
    "besselian-elements",
    "isolines",
    "geojson"
  ],
  "homepage": "https://github.com/imagobea/chasing-totality#readme",
  "bugs": {
    "url": "https://github.com/imagobea/chasing-totality/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imagobea/chasing-totality.git"
  },
  "license": "MIT",
  "author": "imagobea",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "spike:fixtures": "tsx scripts/generate-jsex-fixtures.ts",
    "spike:grid": "tsx scripts/spike-grid.ts",
    "data:airports": "tsx scripts/generate-airports.ts"
  },
  "packageManager": "pnpm@10.18.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^24.19.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "d3-contour": "^4.0.2",
    "fastify": "^5.12.7"
  }
}
