# API settings. Copy to .env to change them locally; every one has a default.

# Port the API listens on
PORT=3000
# 0.0.0.0 so the server is reachable from outside a container
HOST=0.0.0.0
# trace, debug, info, warn, error, fatal or silent; when unset, warn if NODE_ENV=production, else debug
LOG_LEVEL=debug
